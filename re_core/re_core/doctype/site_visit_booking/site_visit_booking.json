{
  "doctype": "DocType",
  "name": "Site Visit Booking",
  "module": "RE Core",
  "custom": 0,
  "naming_rule": "Autoincrement",
  "fields": [
    {"fieldname": "unit", "label": "Unit", "fieldtype": "Link", "options": "Unit", "reqd": 1, "in_list_view": 1},
    {"fieldname": "customer", "label": "Customer", "fieldtype": "Link", "options": "Customer", "reqd": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "visit_date", "label": "Preferred Date", "fieldtype": "Date", "reqd": 1},
    {"fieldname": "visit_time_slot", "label": "Time Slot", "fieldtype": "Select", "options": "10:00 - 12:00\n12:00 - 14:00\n14:00 - 16:00\n16:00 - 18:00", "reqd": 1},
    {"fieldname": "section_break_1", "fieldtype": "Section Break"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Requested\nConfirmed\nCompleted\nCancelled", "default": "Requested"},
    {"fieldname": "assigned_agent", "label": "Assigned Agent", "fieldtype": "Link", "options": "User"},
    {"fieldname": "notes", "label": "Notes", "fieldtype": "Small Text"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Sales User", "read": 1, "write": 1, "create": 1}
  ]
}
